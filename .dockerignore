.git
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache

# Never bake real secrets into an image layer.
.env

# Local/generated data -- mounted as a volume instead (see docker-compose.yml).
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

docs/
notebooks/
README.md

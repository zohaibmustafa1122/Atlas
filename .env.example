# ATLAS environment configuration
# Copy this file to .env and adjust values as needed.
# Never commit the real .env file.

# --- Application ---
APP_NAME=ATLAS
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Phase 1 default: local SQLite file.
# Later phases can point this at a PostgreSQL URL, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/atlas
DATABASE_URL=sqlite:///./data/processed/atlas.db

# --- Data directories ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SYNTHETIC_DATA_DIR=data/synthetic

# --- Optional AI Assistant (Phase 7) ---
# Leave blank to run ATLAS fully without any LLM API.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
